# Copy to .env.local and fill in. Never commit .env.local.
# MongoDB Atlas connection string (replica set, so transactions work).
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=smartliving360

# Random string of 32+ characters, for signing staff sessions. Generate with: openssl rand -base64 48
SESSION_SECRET=
